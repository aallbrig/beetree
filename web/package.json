    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "swagger-ui-dist": "^5.34.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
